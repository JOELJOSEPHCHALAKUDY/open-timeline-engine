{
  "manifest_version": 3,
  "name": "TCE Browser Capture",
  "version": "0.4.0",
  "permissions": ["storage", "tabs", "activeTab", "contextMenus"],
  "host_permissions": ["http://localhost:8080/*", "https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
