# Local Full stack profile. Secrets remain deployment supplied.
TCE_RUNTIME_PROFILE=local-full
TCE_EXECUTION_ENFORCEMENT_LEVEL=protocol_only
TCE_EXECUTION_INTERCEPTION_ATTESTED=false
TCE_AUTH_MODE=bearer
TCE_IDENTITY_CLAIMS_MODE=compat
TCE_WORKSPACE_ACCESS_MODE=compat
TCE_AUDIT_WRITE_MODE=async
TCE_CORS_ALLOW_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TCE_CORS_ALLOW_CREDENTIALS=false
TCE_MCP_TOOL_PROFILE=core
TCE_DEFAULT_OPERATION_MODE=timeline_only
TCE_QDRANT_ENABLED=true
TCE_LLM_EXTRACTION=false
TCE_BEHAVIOR_AUTONOMY_GATE_ENABLED=false
