# Shared workspace profile. Tokens and identity claim mappings are mandatory external inputs.
TCE_RUNTIME_PROFILE=team-secure
TCE_EXECUTION_ENFORCEMENT_LEVEL=protocol_only
TCE_EXECUTION_INTERCEPTION_ATTESTED=false
TCE_AUTH_MODE=bearer
TCE_IDENTITY_CLAIMS_MODE=enforce
TCE_WORKSPACE_ACCESS_MODE=strict
TCE_AUDIT_WRITE_MODE=durable
TCE_CORS_ALLOW_ORIGINS=
TCE_CORS_ALLOW_CREDENTIALS=false
TCE_MCP_TOOL_PROFILE=core
TCE_DEFAULT_OPERATION_MODE=timeline_only
TCE_AUTO_CAPTURE_SKIP_SENSITIVE=true
TCE_BEHAVIOR_STORAGE_GATE_MODE=enforce
TCE_BEHAVIOR_AUTONOMY_GATE_ENABLED=false
