# Opt-in research profile. It collects evidence but never enables autonomy by itself.
TCE_RUNTIME_PROFILE=research
TCE_EXECUTION_ENFORCEMENT_LEVEL=protocol_only
TCE_EXECUTION_INTERCEPTION_ATTESTED=false
TCE_AUTH_MODE=bearer
TCE_IDENTITY_CLAIMS_MODE=enforce
TCE_WORKSPACE_ACCESS_MODE=strict
TCE_AUDIT_WRITE_MODE=durable
TCE_CORS_ALLOW_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TCE_CORS_ALLOW_CREDENTIALS=false
TCE_MCP_TOOL_PROFILE=research
TCE_DEFAULT_OPERATION_MODE=clone_advisor
TCE_BEHAVIOR_EVIDENCE_ENABLED=true
TCE_BEHAVIOR_FIDELITY_ENABLED=true
TCE_BEHAVIOR_PROJECTIONS_ENABLED=true
TCE_BEHAVIOR_PROJECTION_PILOT_ENABLED=true
TCE_BEHAVIOR_SHADOW_EVALUATION_ENABLED=true
TCE_BEHAVIOR_MEMORY_REVIEW_ENABLED=true
TCE_BEHAVIOR_AUTONOMY_GATE_ENABLED=false
TCE_BEHAVIOR_STORAGE_GATE_MODE=warn
