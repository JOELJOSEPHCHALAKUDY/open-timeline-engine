TCE_ADVISOR_PROVIDER_TIMEOUT_MS=6000
TCE_ADVISOR_PROVIDER_RETRY_MAX=2
TCE_ADVISOR_CUSTOM_HEADERS_ALLOWLIST=x-api-key,x-tenant-id,anthropic-version,x-goog-user-project,x-request-id
TCE_QDRANT_ENABLED=true
TCE_QDRANT_URL=http://qdrant:6333
TCE_QDRANT_COLLECTION=tce_event_embeddings
TCE_QDRANT_TIMEOUT_MS=80
TCE_QDRANT_SYNC_ENABLED=true
TCE_QDRANT_SYNC_BATCH_SIZE=500
TCE_QDRANT_SYNC_MAX_BATCHES=10
