TCE_LLM_EXTRACTION=false
TCE_AUTH_MODE=dual
TCE_API_TOKENS=local-dev-token
TCE_API_TOKEN=local-dev-token
TCE_IDENTITY_CLAIMS_MODE=compat
# Map bearer:<sha256-token> or mtls:<sha256-subject> to server-owned identity claims.
TCE_IDENTITY_CLAIMS_JSON={}
TCE_MTLS_REQUIRED=false
TCE_CORS_ALLOW_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
TCE_CORS_ALLOW_CREDENTIALS=false
TCE_BLOCK_SENSITIVITY=3
TCE_ENABLE_PAYLOAD_ENCRYPTION=false
TCE_ENCRYPT_MIN_SENSITIVITY=2
TCE_DEFAULT_OPERATION_MODE=timeline_only
TCE_CLONE_MAX_TURNS_PER_INTERACTION=40
TCE_CLONE_FALLBACK_TO_TIMELINE=true
TCE_CONTEXT_TIERS_ENABLED=false
TCE_INTENT_RETRIEVAL_ENABLED=false
TCE_RETRY_FEEDBACK_ENABLED=false
TCE_PROFILE_TUNING_ENABLED=false
