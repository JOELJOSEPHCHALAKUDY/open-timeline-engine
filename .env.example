TCE_PATTERN_WEIGHT_RECENCY=0.30
TCE_PATTERN_WEIGHT_CONSISTENCY=0.20
TCE_PATTERN_WEIGHT_FEEDBACK=0.15
TCE_WORKER_RETRY_MAX=3
