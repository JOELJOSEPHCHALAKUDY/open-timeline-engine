TCE_LOG_LEVEL=INFO
TCE_RUNTIME_PROFILE=local-full
TCE_EXECUTION_ENFORCEMENT_LEVEL=protocol_only
TCE_EXECUTION_INTERCEPTION_ATTESTED=false
TCE_EXECUTION_INTERCEPTION_PROVIDER=

# Privileged-endpoint guard: stack restart and .env-writing config endpoints
# refuse to run while the default API token is configured. Set to 1 only for
# a purely local dev install.
TCE_ALLOW_DEFAULT_TOKEN=0
