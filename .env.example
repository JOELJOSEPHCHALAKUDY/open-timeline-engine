TCE_EMBED_MODEL=nomic-embed-text
TCE_EMBEDDING_DIMENSIONS=1024
TCE_EXTRACT_MODEL=qwen2.5:7b
TCE_MODEL_PROVIDER=ollama
TCE_OPENAI_API_KEY=
