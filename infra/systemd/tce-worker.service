[Unit]
Description=Open Timeline Engine Worker
After=network.target

[Service]
WorkingDirectory=/opt/open-timeline-engine
EnvironmentFile=/opt/open-timeline-engine/.env
ExecStart=/usr/bin/env PYTHONPATH=shared:services/tce_worker python -m tce_worker.worker
Restart=always
User=tce

[Install]
WantedBy=multi-user.target
